{
  "name": "@datadog/openfeature-client-monorepo",
  "repository": "git@github.com:DataDog/openfeature-js-client.git",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build --stream",
    "build:bundle": "lerna run build:bundle --stream",
    "test": "lerna run test --stream",
    "test:unit": "lerna run test --stream",
    "test:unit:watch": "lerna run test --stream --parallel",
    "test:browser-install": "scripts/test-package-install.sh",
    "test:node-install": "scripts/test-node-package-install.sh",
    "test:node-install:with-of": "scripts/test-node-package-install.sh --with-openfeature",
    "licenses:validate": "scripts/licenses-validate.sh",
    "lint": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check --write .",
    "typecheck": "lerna run typecheck --stream",
    "clean": "lerna run clean --stream",
    "release": "scripts/cli release",
    "release:all": "scripts/cli release_all",
    "version": "scripts/cli version",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "setup": "yarn install && yarn allow-scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@lavamoat/allow-scripts": "^3.4.3",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@types/node": "^18.19.130",
    "glob": "^13.0.6",
    "jest": "^30.0.5",
    "lerna": "^9.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "5.106.2"
  },
  "packageManager": "yarn@4.10.3",
  "dependencies": {
    "emoji-name-map": "^2.0.3"
  },
  "lavamoat": {
    "allowScripts": {
      "$root$": false,
      "@lavamoat/preinstall-always-fail": false,
      "jest>@jest/core>jest-resolve>unrs-resolver": true,
      "lerna>nx": true
    }
  },
  "resolutions": {
    "tar@npm:7.5.11": "npm:^7.5.22",
    "minimatch@npm:10.1.1": "npm:^10.2.6",
    "js-yaml@npm:4.1.1": "npm:^4.3.1",
    "typescript@npm:>=5.0.2": "npm:5.9.3",
    "axios@npm:^1.12.0": "npm:^1.20.0",
    "undici@npm:^7.24.5": "npm:^7.29.0",
    "fast-uri@npm:^3.0.1": "npm:^3.1.6",
    "brace-expansion@npm:^1.1.7": "npm:^1.1.18",
    "brace-expansion@npm:^2.0.1": "npm:^2.1.4",
    "picomatch@npm:^4.0.2": "npm:^4.0.7",
    "picomatch@npm:^4.0.3": "npm:^4.0.7",
    "ws@npm:^8.18.0": "npm:^8.21.3",
    "tmp@npm:~0.2.1": "npm:>=0.2.7",
    "form-data@npm:^4.0.5": "npm:^4.0.6",
    "sigstore@npm:^4.0.0": "npm:^4.1.1",
    "pacote@npm:21.0.1": "npm:^21.5.1",
    "yaml@npm:^2.6.0": "npm:^2.8.4",
    "@sigstore/verify@npm:^3.1.0": "npm:^3.1.1",
    "ajv@npm:^8.0.0": "npm:^8.20.0",
    "ajv@npm:^8.9.0": "npm:^8.20.0",
    "@sigstore/core@npm:^3.1.0": "npm:^3.2.1"
  }
}

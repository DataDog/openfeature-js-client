{
  "name": "@datadog/openfeature-client-monorepo",
  "repository": "git@github.com:DataDog/openfeature-js-client.git",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build --stream",
    "build:bundle": "lerna run build:bundle --stream",
    "test": "lerna run test --stream",
    "test:unit": "lerna run test --stream",
    "test:unit:watch": "lerna run test --stream --parallel",
    "test:browser-install": "scripts/test-package-install.sh",
    "test:node-install": "scripts/test-node-package-install.sh",
    "test:node-install:with-of": "scripts/test-node-package-install.sh --with-openfeature",
    "licenses:validate": "scripts/licenses-validate.sh",
    "lint": "biome check . --diagnostic-level=error",
    "lint:fix": "biome check --write .",
    "typecheck": "lerna run typecheck --stream",
    "clean": "lerna run clean --stream",
    "release": "scripts/cli release",
    "version": "scripts/cli version",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "setup": "yarn install && yarn allow-scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@lavamoat/allow-scripts": "^3.4.3",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@types/node": "^18.19.130",
    "glob": "^11.0.3",
    "jest": "^30.0.5",
    "lerna": "^9.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "5.105.4"
  },
  "packageManager": "yarn@4.10.3",
  "dependencies": {
    "emoji-name-map": "^2.0.3"
  },
  "lavamoat": {
    "allowScripts": {
      "$root$": false,
      "@lavamoat/preinstall-always-fail": false,
      "jest>@jest/core>jest-resolve>unrs-resolver": true,
      "lerna>nx": true
    }
  }
}

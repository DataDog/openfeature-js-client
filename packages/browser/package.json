{
  "name": "@datadog/openfeature-browser",
  "version": "1.2.5",
  "description": "Browser-specific bindings for OpenFeature (wraps @datadog/openfeature-core)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/DataDog/openfeature-js-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DataDog/openfeature-js-client.git",
    "directory": "packages/browser"
  },
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "cjs/index.d.ts",
  "typesVersions": {
    "*": {
      "configuration": [
        "cjs/configuration.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./cjs/index.d.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "default": "./esm/index.js"
    },
    "./configuration": {
      "types": "./cjs/configuration.d.ts",
      "import": "./esm/configuration.js",
      "require": "./cjs/configuration.js",
      "default": "./esm/configuration.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "cjs/",
    "esm/",
    "bundle/",
    "*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "yarn build",
    "pack": "yarn pack",
    "build": "run-p build:cjs build:esm build:bundle",
    "build:bundle": "rm -rf bundle && SDK_SETUP=cdn node ../../scripts/webpack-runner.js webpack.config.js --mode=production",
    "build:cjs": "rm -rf cjs && tsc -p tsconfig.cjs.json && yarn replace-build-env cjs",
    "build:esm": "rm -rf esm && tsc -p tsconfig.esm.json && yarn replace-build-env esm",
    "replace-build-env": "node ../../scripts/build/replace-build-env.js",
    "clean": "rm -rf dist cjs esm bundle",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datadog/browser-core": "^6.33.0",
    "@datadog/flagging-core": "2.0.2",
    "@datadog/js-core": "0.0.3"
  },
  "peerDependencies": {
    "@openfeature/core": "^1.9.2",
    "@openfeature/web-sdk": "^1.5.0"
  },
  "devDependencies": {
    "@openfeature/core": "^1.9.2",
    "@openfeature/web-sdk": "^1.5.0",
    "@types/chrome": "^0.1.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "jest-util": "^30.0.2",
    "jsdom": "^29.0.1",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.5.0",
    "whatwg-fetch": "^3.6.20"
  }
}

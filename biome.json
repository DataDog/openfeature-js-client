{
  "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@datadog/*/cjs/**"],
                "message": "Do not import from /cjs/ subpaths — use the package root or /esm/ path. /cjs/ specifiers are preserved verbatim in the ESM build output, causing bundlers to pull CJS modules into the ESM graph."
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist",
      "!**/cjs",
      "!**/esm",
      "!.pnp.*",
      "!**/bundle",
      "!**/coverage",
      "!**/*.tgz",
      "!test-app/node_modules"
    ]
  }
}
